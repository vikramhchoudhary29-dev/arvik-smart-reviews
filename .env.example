# Copy to .env. Do not commit a populated .env.
# Local app: use a NEW development database; never point tests at live Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# HTTPS origin in production; localhost is allowed for local QR testing.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate a long random value using the command in README.
RATE_LIMIT_SECRET=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Service-account key in PEM form, with literal \n for line breaks.
FIREBASE_PRIVATE_KEY=""
# Comma-separated VERIFIED Firebase account emails. Empty denies all admin access.
ADMIN_EMAILS=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# Task 5 reports use the existing database and Firebase settings; no new service credentials.
