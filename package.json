{
  "name": "arvik-smart-reviews",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "cleanup": "node --env-file-if-exists=.env --import tsx scripts/cleanup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "fflate": "^0.8.3",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "next": "^16.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "deepmerge-ts": "8.0.2",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
