generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum StampMethod {
  PER_PURCHASE
  AMOUNT_BASED
}

enum EventType {
  PAGE_VIEW
  GOOGLE_LINK_CLICK
  SUGGESTION_GENERATE
  SUGGESTION_REGENERATE
  COPY_SUGGESTION
}

model Business {
  id              String             @id @default(cuid())
  name            String
  category        String             @default("general")
  contactName     String             @default("")
  phone           String             @default("")
  whatsapp        String             @default("")
  renewalWhatsapp String             @default("")
  email           String             @default("")
  address         String             @default("")
  city            String             @default("")
  state           String             @default("")
  pincode         String             @default("")
  googleMapsUrl   String             @default("")
  logo            String             @default("")
  coverImage      String             @default("")
  description     String             @default("")
  welcomeMessage  String             @default("")
  internalNotes   String             @default("")
  brandColor      String             @default("#10b981")
  linkTestedAt    DateTime?
  slug            String             @unique
  googleReviewUrl String
  status          BusinessStatus     @default(INACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  stands          Stand[]
  customers       Customer[]
  loyaltyProgram  LoyaltyProgram?
  transactions    StampTransaction[]
  events          AnalyticsEvent[]
  owners          BusinessOwner[]
  staff           StaffMember[]
  experience      BusinessExperience?
  subscriptions   SubscriptionPeriod[]
}

model Stand {
  id           String           @id @default(cuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id])
  code         String           @unique
  type         String           @default("NFC_QR")
  location     String           @default("")
  updatedAt    DateTime         @default(now()) @updatedAt
  lastActivity DateTime?
  label        String?
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  events       AnalyticsEvent[]

  @@index([businessId])
}

model Customer {
  id           String             @id @default(cuid())
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id])
  phone        String
  name         String?
  consentAt    DateTime?
  createdAt    DateTime           @default(now())
  transactions StampTransaction[]
  redemptions  RewardRedemption[]

  @@unique([businessId, phone])
}

model LoyaltyProgram {
  id                String      @id @default(cuid())
  businessId        String      @unique
  business          Business    @relation(fields: [businessId], references: [id])
  method            StampMethod
  amountPerStamp    Int?
  stampsRequired    Int
  rewardDescription String
  carryForward      Boolean     @default(false)
  active            Boolean     @default(true)
  updatedAt         DateTime    @updatedAt
}

model StampTransaction {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  stamps         Int
  purchaseAmount Int?
  reference      String?
  approvedBy     String
  createdAt      DateTime @default(now())
}

model RewardRedemption {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  code       String   @unique
  stampsUsed Int
  redeemedAt DateTime @default(now())
}

model AnalyticsEvent {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])
  standId    String?
  stand      Stand?    @relation(fields: [standId], references: [id])
  dedupKey   String?   @unique
  type       EventType
  createdAt  DateTime  @default(now())

  @@index([createdAt, type])
  @@index([businessId, createdAt])
  @@index([standId, createdAt])
}

model ReviewPhrase {
  sentiment String   @default("neutral")
  id        String   @id @default(cuid())
  category  String
  tag       String
  text      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([category, sentiment, active])
}

model ApplicationSettings {
  id            String   @id @default("default")
  supportEmail  String   @default("")
  retentionDays Int      @default(90)
  updatedAt     DateTime @updatedAt
}

model RateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model AdminAudit {
  actorEmail String   @default("")
  id         String   @id @default(cuid())
  action     String
  targetId   String
  createdAt  DateTime @default(now())
}

model MediaAsset {
  id        String   @id @default(cuid())
  mime      String
  bytes     Bytes
  createdAt DateTime @default(now())
}

model BusinessOwner {
  id          String   @id @default(cuid())
  firebaseUid String
  email       String
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([firebaseUid, businessId])
  @@index([firebaseUid, active])
  @@index([businessId])
}

model BusinessExperience {
  businessId   String   @id
  business     Business @relation(fields: [businessId], references: [id])
  staffEnabled Boolean  @default(false)
  staffQuestion String  @default("")
  updatedAt    DateTime @updatedAt
}

model StaffMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  name       String
  role       String   @default("")
  active     Boolean  @default(true)
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  mentions   StaffMention[]

  @@index([businessId, active])
}

model SubscriptionPeriod {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id])
  startsOn       DateTime @db.Date
  expiresOn      DateTime @db.Date
  annualFeePaise Int
  currency       String   @default("INR")
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  payments       SubscriptionPayment[]

  @@unique([businessId, startsOn])
  @@index([businessId, expiresOn])
  @@index([expiresOn])
}

model SubscriptionPayment {
  id             String   @id @default(cuid())
  subscriptionId String
  subscription   SubscriptionPeriod @relation(fields: [subscriptionId], references: [id])
  amountPaise    Int
  paidOn         DateTime @db.Date
  method         String
  reference      String   @default("")
  createdAt      DateTime @default(now())
  voidedAt       DateTime?

  @@index([subscriptionId, voidedAt])
}

// Each successful generation request can mention at most one selected staff member.
// Kept separate so existing analytics and historical events are unchanged.
model StaffMention {
  id         String      @id @default(cuid())
  dedupKey   String      @unique
  businessId String
  standId    String
  staffId    String
  staff      StaffMember @relation(fields: [staffId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([businessId, createdAt])
  @@index([staffId, createdAt])
}
